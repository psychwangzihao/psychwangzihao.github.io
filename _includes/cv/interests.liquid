{% comment %}
  Unified interests entry renderer for both formats

  name 粗体，keywords 用浅色接在后面、中间一个破折号 —— 读下来是
  「Consciousness — its contents, and the states …」。
  只写 name 的话，卡片里就是几个孤零零的粗体词，很难看。
{% endcomment %}

<div class="card-text font-weight-light">
  {% for entry in entries %}
    <div class="interest-item">
      {% if entry.icon %}
        <i class="{{ entry.icon }}"></i>
      {% endif %}
      <strong>{{ entry.name }}</strong>
      {% if entry.keywords %}
        <span class="interest-kw"> — {% for keyword in entry.keywords %}{% if forloop.last %}{{ keyword }}{% else %}{{ keyword }}, {% endif %}{% endfor %}</span>
      {% endif %}
    </div>
  {% endfor %}
</div>

<style>
  .interest-item {
    padding: 0.5rem 0;
  }

  .interest-kw {
    color: var(--global-text-color-light);
  }
</style>
