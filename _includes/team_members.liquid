{% if site.data.group_members %}
<div class="team-members">
  {% for member in site.data.group_members %}
  <div class="team-member" style="margin-bottom: 2rem; padding: 1.5rem; border: 1px solid var(--global-divider-color); border-radius: 8px; background: var(--global-card-bg-color);">
    <div class="row">
      <div class="col-md-3 text-center">
        {% if member.image %}
          {% assign member_image = member.image | prepend: 'assets/img/' %}
          <img src="{{ member_image | relative_url }}" alt="{{ member.name }}"
               style="width: 140px; height: 140px; object-fit: cover; border-radius: 50%; margin-bottom: 0.5rem;"
               loading="lazy">
        {% endif %}
        <p style="margin: 0.25rem 0;">
          {% if member.website %}
            <a href="{{ member.website }}" target="_blank" rel="noopener"><strong>{{ member.name }}</strong></a>
          {% else %}
            <strong>{{ member.name }}</strong>
          {% endif %}
        </p>
        <p style="font-size: 0.85rem; color: var(--global-text-color-light); margin: 0;">{{ member.role }}</p>
      </div>
      <div class="col-md-9">
        <p style="margin-bottom: 0.5rem;"><em>{{ member.research }}</em></p>
        {% if member.bio %}
          <p>{{ member.bio }}</p>
        {% endif %}
        <p style="font-size: 0.85rem; margin-bottom: 0;">
          📧 <a href="mailto:{{ member.contact }}">{{ member.contact }}</a>
        </p>
      </div>
    </div>
  </div>
  {% endfor %}
</div>
{% else %}
<p><em>No team members listed yet. Check back soon!</em></p>
{% endif %}
