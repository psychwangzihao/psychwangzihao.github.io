{% if site.data.group_members %}
<div class="team-members">
  {% for member in site.data.group_members %}
  <div class="team-member-card" style="margin-bottom: 2rem; padding: 1.75rem 1.5rem; border: 1px solid var(--global-divider-color); border-radius: 10px; background: var(--global-card-bg-color);">
    <div class="row align-items-center">
      <!-- Left: Photo -->
      <div class="col-md-3 text-center mb-3 mb-md-0">
        {% if member.image %}
          {% assign member_image = member.image | prepend: 'assets/img/' %}
          <img src="{{ member_image | relative_url }}" alt="{{ member.name }}"
               style="width: 150px; height: 150px; object-fit: cover; border-radius: 50%;"
               loading="lazy">
        {% else %}
          <div style="width: 150px; height: 150px; border-radius: 50%; background: var(--global-divider-color); display: inline-flex; align-items: center; justify-content: center; font-size: 2.5rem; color: var(--global-text-color-light);">
            {{ member.name | slice: 0, 1 }}
          </div>
        {% endif %}
      </div>

      <!-- Right: Info -->
      <div class="col-md-9">
        <!-- Name -->
        <p style="font-size: 1.2rem; font-weight: 600; margin-bottom: 0.3rem;">
          {{ member.name }}
        </p>

        <!-- Background -->
        {% if member.background %}
          <p style="font-size: 0.95rem; margin-bottom: 0.15rem; color: var(--global-text-color);">
            {{ member.background }}
          </p>
        {% endif %}

        <!-- Institution -->
        {% if member.institution %}
          <p style="font-size: 0.9rem; margin-bottom: 0.3rem; color: var(--global-text-color-light);">
            {{ member.institution }}
          </p>
        {% endif %}

        <!-- Contact -->
        {% if member.contact %}
          <p style="font-size: 0.85rem; margin-bottom: 0.55rem; color: var(--global-text-color-light);">
            📧 <a href="mailto:{{ member.contact }}" style="color: var(--global-text-color-light); text-decoration: none;">{{ member.contact }}</a>
          </p>
        {% endif %}

        <!-- Research Focus (bold with accent left border) -->
        {% if member.research_focus %}
          <p style="font-weight: 600; font-size: 0.95rem; margin-bottom: 0; padding: 0.4rem 0 0.4rem 0.85rem; border-left: 3px solid var(--global-theme-color);">
            {{ member.research_focus }}
          </p>
        {% endif %}
      </div>
    </div>
  </div>
  {% endfor %}
</div>
{% else %}
<p><em>No team members listed yet. Check back soon!</em></p>
{% endif %}
