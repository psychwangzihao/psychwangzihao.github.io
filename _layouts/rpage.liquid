<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    {% include head.liquid %}
  </head>

  <!-- 组会/答辩用的全屏页：没有顶部那条导航、没有页脚，内容占满视口并垂直居中。
       返回上一层的入口只有正文里的「← xxx」链接 —— 这是刻意的，全屏时
       屏幕上的每个字都应该是内容。 -->
  <body class="r-body-page">
    <style>
      /* ⚠️ 关键就在这一行：抬的是**根字号**，不是某个容器。
         页面正文里的字号全是 rem，跟着根字号一起放大 —— 只调容器的话
         那些 rem 还是按 16px 算，一点都不会变大。 */
      html { font-size: clamp(15px, 1.30vw, 26px); }

      body.r-body-page {
        background: var(--global-bg-color);
        margin: 0;
      }
      .r-wrap {
        min-height: 100vh;
        box-sizing: border-box;
        display: flex; flex-direction: column; justify-content: center;
        padding: 5vh clamp(1.5rem, 4.5vw, 4.5rem);
        max-width: 1580px;
        margin: 0 auto;
      }
      .r-head { margin-bottom: .6rem; }
      .r-title {
        font-weight: 600; line-height: 1.2;
        margin: 0 0 .4em; color: var(--global-text-color);
      }
      .r-desc { line-height: 1.6; margin: 0; color: var(--global-text-color-light); }
      /* 正文里写死的段宽也跟着根字号走，不用改页面 */
      .r-body p, .r-body li { line-height: 1.75; }
      .r-body h2 { margin: 1.5em 0 .55em; }
      /* 页脚那条（Copyright / Powered by）全屏时不要 */
      footer.fixed-bottom, .fixed-bottom { display: none; }

      /* 右上角「真·全屏」按钮：平时很淡，鼠标移上去才实。投影时
         不会抢内容，但伸手就能按到。 */
      .r-fs {
        position: fixed; top: .7rem; right: .9rem; z-index: 60;
        display: flex; padding: .35rem; border: 0; border-radius: .35rem;
        background: transparent; color: var(--global-text-color-light);
        opacity: .22; cursor: pointer;
        transition: opacity .18s, background .18s;
      }
      .r-fs:hover, .r-fs:focus-visible { opacity: 1; background: rgba(128,128,128,.14); }
      .r-fs svg { width: 1.15rem; height: 1.15rem; display: block; }
      .r-fs .ic-out { display: none; }
      body.r-fs-on .r-fs .ic-in  { display: none; }
      body.r-fs-on .r-fs .ic-out { display: block; }

      /* 全屏演示时鼠标不动就藏起来，免得停在标题上 */
      body.r-fs-on.r-idle { cursor: none; }
      body.r-fs-on.r-idle .r-fs { opacity: 0; }
      body.r-fs-on #back-to-top, body.r-fs-on .back-to-top { display: none !important; }
    </style>

    <div class="r-wrap">
      <header class="r-head">
        <h1 class="r-title">{{ page.title }}</h1>
        {% if page.description %}<p class="r-desc">{{ page.description }}</p>{% endif %}
      </header>
      <article class="r-body">
        {{ content }}
      </article>
    </div>

    <button id="rfs" class="r-fs" title="全屏 / 退出全屏（F）" aria-label="全屏">
      <svg class="ic-in" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M8 21H5a2 2 0 0 1-2-2v-3M16 21h3a2 2 0 0 0 2-2v-3"/>
      </svg>
      <svg class="ic-out" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 8h3a2 2 0 0 0 2-2V3M21 8h-3a2 2 0 0 1-2-2V3M3 16h3a2 2 0 0 1 2 2v3M21 16h-3a2 2 0 0 0-2 2v3"/>
      </svg>
    </button>

    <script>
      (function () {
        var btn = document.getElementById('rfs');
        var root = document.documentElement;

        function isFs() {
          return !!(document.fullscreenElement || document.webkitFullscreenElement);
        }
        function toggle() {
          if (isFs()) {
            (document.exitFullscreen || document.webkitExitFullscreen).call(document);
          } else {
            var req = root.requestFullscreen || root.webkitRequestFullscreen;
            // 有些浏览器不接受 Promise（Safari 老版），所以不直接 .catch
            if (req) { var p = req.call(root); if (p && p.catch) p.catch(function () {}); }
          }
        }

        btn.addEventListener('click', toggle);

        ['fullscreenchange', 'webkitfullscreenchange'].forEach(function (ev) {
          document.addEventListener(ev, function () {
            document.body.classList.toggle('r-fs-on', isFs());
          });
        });

        document.addEventListener('keydown', function (e) {
          if (e.metaKey || e.ctrlKey || e.altKey) return;
          if (e.key === 'f' || e.key === 'F') { e.preventDefault(); toggle(); }
        });

        // 全屏且鼠标静止 2.5 秒后隐藏光标（退出全屏立刻恢复）
        var t;
        function wake() {
          document.body.classList.remove('r-idle');
          clearTimeout(t);
          t = setTimeout(function () {
            if (isFs()) document.body.classList.add('r-idle');
          }, 2500);
        }
        ['mousemove', 'mousedown', 'keydown'].forEach(function (ev) {
          document.addEventListener(ev, wake, { passive: true });
        });
      })();
    </script>

    {% include scripts.liquid %}
  </body>
</html>
